# Продакшен: скопируйте в .env и заполните (SPEC §16.1). Файл .env не коммитится.

# Домен сайта: Caddy получит для него сертификат Let's Encrypt (A-запись должна указывать на сервер).
DOMAIN=party.example.com
# Адрес сайта для проверки Origin и ссылок. По умолчанию https://$DOMAIN.
# APP_URL=https://party.example.com

# Пароль пользователя БД (длинный случайный: `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me
# DATABASE_URL для контейнера web собирается из POSTGRES_PASSWORD в docker-compose.yml.
# Для запуска без Docker: DATABASE_URL=postgres://party:<пароль>@localhost:5432/party_sheet

# Первый администратор — создаётся при первом запуске, если пользователей ещё нет.
ADMIN_EMAIL=gm@example.com
ADMIN_PASSWORD=change-me-too

# Каталог загрузок (портреты, изображения заметок). В Docker — том uploads.
UPLOAD_DIR=/data/uploads

# Резервные копии: сколько дней хранить, во сколько делать (часовой пояс TZ),
# в какой день недели архивировать загрузки (1 = пн … 7 = вс).
BACKUP_RETENTION_DAYS=14
BACKUP_TIME=03:30
UPLOADS_BACKUP_WEEKDAY=7
TZ=Europe/Moscow

# Необязательно.
SENTRY_DSN=
LOG_LEVEL=info
